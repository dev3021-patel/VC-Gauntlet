{
    admin off
    auto_https off
}
:{$PORT:8080} {
    root * /srv
    encode zstd gzip
    handle_path /api/* {
        reverse_proxy {$BACKEND_UPSTREAM}
    }
    handle /assets/* {
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }
    handle {
        header Cache-Control "no-cache"
        try_files {path} /index.html
        file_server
    }
}
